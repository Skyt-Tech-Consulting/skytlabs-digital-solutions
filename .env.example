# ---------------------------------------------------------------------------
# SkytLabs website — server configuration
# Copy to .env.local for local development. In production set these as
# environment variables / secrets on the hosting platform.
# ---------------------------------------------------------------------------

# First administrator account. Used only to create the first admin the first
# time someone signs in at /admin while no users exist. After that, manage
# users in the admin (Users page) — you can remove these afterwards.
ADMIN_EMAIL=admin@skytlabs.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Secret used to sign admin session cookies (32+ random characters).
# If omitted, a random secret is generated and stored in CMS storage.
SESSION_SECRET=

# Contact-form email notifications via SMTP (Zoho Mail, info@skytlabs.com).
# SMTP_HOST depends on your Zoho data centre: smtppro.zoho.com / .eu / .in / .com.au / .jp
# SMTP_PASSWORD should be a Zoho app-specific password (My Account > Security > App Passwords).
# EMAIL_FROM must be info@skytlabs.com (or an alias of it); defaults to SMTP_USER.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=info@skytlabs.com
SMTP_PASSWORD=
EMAIL_FROM="SkytLabs Website <info@skytlabs.com>"
# Fallback recipient until one is saved in Admin > Settings.
CONTACT_NOTIFICATION_EMAIL=info@skytlabs.com

# Alternative email provider (only used when the SMTP variables are not set).
# RESEND_API_KEY=

# Optional: Cloudflare Turnstile spam challenge on the contact form.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Storage on Vercel (required in production):
#  - Neon Postgres (Storage tab)  -> sets DATABASE_URL (content, enquiries, users)
#  - Vercel Blob (Storage tab)    -> sets BLOB_READ_WRITE_TOKEN (image uploads)
# Connecting both stores to the project adds these automatically.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Local development without a database stores everything under CMS_DATA_DIR
# (default .data/cms). Not usable on Vercel (temporary filesystem).
# CMS_DATA_DIR=.data/cms
